{
  "name": "cajero-ai-pos",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "start:dev": "concurrently \"cd backend && ./gradlew bootRun\" \"cd frontend && npm run dev\"",
    "build:all": "npm-run-all build:backend build:frontend",
    "build:backend": "cd backend && ./gradlew clean build -x test --refresh-dependencies",
    "build:frontend": "cd frontend && npm run build",
    "clean:backend": "cd backend && rm -rf ~/.gradle/caches/ ~/.gradle/daemon/ && ./gradlew clean",
    "backend": "cd backend && ./gradlew bootRun",
    "frontend": "cd frontend && npm run dev",
    "test:all": "npm-run-all test:backend test:frontend",
    "clean:docker": "./clean-start.sh",
    "release:notes": "node ./scripts/generate-release-notes.js",
    "tag:mobile": "cd mobile && yarn tag:release",
    "test:scripts": "node --test scripts/__tests__/*.test.js",
    "wiki:sync": "./scripts/sync-wiki.sh"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "concurrently": "^8.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "npm-run-all": "^4.1.5"
  }
}
