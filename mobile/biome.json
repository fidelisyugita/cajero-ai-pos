{
  "$schema": "https://biomejs.dev/schemas/2.5.10/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "defaultBranch": "main"
  },
  "files": {
    "ignoreUnknown": false,
    "includes": ["**/*.ts", "**/*.tsx", "**/*.js", "**/*.jsx", "**/*.json"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "globals": [
      "describe",
      "it",
      "test",
      "expect",
      "jest",
      "beforeEach",
      "afterEach",
      "beforeAll",
      "afterAll"
    ],
    "formatter": {
      "quoteStyle": "double",
      "jsxQuoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all",
      "bracketSpacing": true,
      "bracketSameLine": false,
      "arrowParentheses": "always"
    }
  },
  "json": {
    "formatter": {
      "trailingCommas": "none"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on",
        "useSortedAttributes": "off"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": {
        "preset": "none"
      },
      "correctness": {
        "preset": "recommended",
        "noUnusedVariables": "error",
        "noUnusedImports": "error",
        "useExhaustiveDependencies": "error",
        "useHookAtTopLevel": "error",
        "useJsxKeyInIterable": "error"
      },
      "suspicious": {
        "preset": "recommended",
        "noConsole": {
          "level": "error",
          "options": {
            "allow": ["warn", "error"]
          }
        },
        "noExplicitAny": "error",
        "noArrayIndexKey": "error",
        "noFocusedTests": "error",
        "noDoubleEquals": "error",
        "noDuplicateJsxProps": "error"
      },
      "security": {
        "preset": "recommended",
        "noDangerouslySetInnerHtml": "error"
      },
      "style": {
        "preset": "recommended",
        "useImportType": "error",
        "useExportType": "error",
        "noNonNullAssertion": "error",
        "useConst": "error",
        "useSelfClosingElements": "error",
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "dayjs": "Do not import dayjs directly. Use centralized date helpers from @/utils/Date instead.",
              "moment": "Do not use moment. Use centralized date helpers from @/utils/Date instead.",
              "date-fns": "Do not use date-fns. Use centralized date helpers from @/utils/Date instead.",
              "luxon": "Do not use luxon. Use centralized date helpers from @/utils/Date instead.",
              "lodash": "Do not import monolithic lodash. Use native JS methods, lodash-es, or lightweight shims instead.",
              "@expo/vector-icons": "Do not import from '@expo/vector-icons' barrel. Use deep icon set imports like '@expo/vector-icons/Feather' to avoid bundling unused font assets."
            },
            "patterns": [
              {
                "group": ["dayjs/**", "date-fns/**"],
                "message": "Do not import date sub-modules directly. Use @/utils/Date instead."
              },
              {
                "group": ["lodash/**"],
                "message": "Do not import lodash sub-modules. Use native JS methods or lightweight shims instead."
              }
            ]
          }
        }
      },
      "performance": {
        "preset": "recommended",
        "noDelete": "error",
        "noAccumulatingSpread": "error",
        "useTopLevelRegex": "error"
      },
      "complexity": {
        "preset": "recommended",
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": {
            "maxAllowedComplexity": 10
          }
        },
        "useSimplifiedLogicExpression": "error",
        "noUselessTernary": "error",
        "noUselessFragments": "error",
        "noUselessSwitchCase": "error",
        "noUselessThisAlias": "error",
        "useFlatMap": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["utils/Date.ts", "index.ts", "jest.setup.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    },
    {
      "includes": ["app/**", "components/**"],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": {
              "level": "error",
              "options": {
                "maxAllowedComplexity": 15
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "**/__tests__/**",
        "**/*.test.ts",
        "**/*.test.tsx",
        "jest.setup.ts",
        "jest.config.js",
        "scripts/**",
        "plugins/**"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off"
          },
          "complexity": {
            "noExcessiveCognitiveComplexity": "off"
          },
          "performance": {
            "useTopLevelRegex": "off"
          }
        }
      }
    }
  ]
}
