{
  "$schema": "https://biomejs.dev/schemas/2.5.10/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "defaultBranch": "main"
  },
  "files": {
    "ignoreUnknown": false,
    "includes": ["**/*.ts", "**/*.tsx", "**/*.js", "**/*.jsx", "**/*.json"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "globals": [
      "describe",
      "it",
      "test",
      "expect",
      "jest",
      "beforeEach",
      "afterEach",
      "beforeAll",
      "afterAll"
    ],
    "formatter": {
      "quoteStyle": "double",
      "jsxQuoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all",
      "bracketSpacing": true,
      "bracketSameLine": false,
      "arrowParentheses": "always"
    }
  },
  "json": {
    "formatter": {
      "trailingCommas": "none"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on",
        "useSortedAttributes": "off"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": {
        "preset": "none"
      },
      "correctness": {
        "preset": "recommended",
        "noChildrenProp": "error",
        "noConstantCondition": "error",
        "noDuplicateVariableNames": "error",
        "noEmptyPattern": "error",
        "noNestedComponentDefinitions": "error",
        "noRenderReturnValue": "error",
        "noSelfAssign": "error",
        "noStringCaseMismatch": "error",
        "noUnsafeOptionalChaining": "error",
        "noUnusedImports": "error",
        "noUnusedVariables": "error",
        "useExhaustiveDependencies": "error",
        "useHookAtTopLevel": "error",
        "useJsxKeyInIterable": "error"
      },
      "suspicious": {
        "preset": "recommended",
        "noArrayIndexKey": "error",
        "noAsyncPromiseExecutor": "error",
        "noConsole": {
          "level": "error",
          "options": {
            "allow": ["warn", "error"]
          }
        },
        "noConstantBinaryExpressions": "error",
        "noControlCharactersInRegex": "error",
        "noDeprecatedImports": "error",
        "noDoubleEquals": "error",
        "noDuplicateCase": "error",
        "noDuplicateElseIf": "error",
        "noDuplicateJsxProps": "error",
        "noDuplicateObjectKeys": "error",
        "noDuplicateParameters": "error",
        "noEmptyInterface": "error",
        "noExplicitAny": "error",
        "noFocusedTests": "error",
        "noMisleadingCharacterClass": "error",
        "noNonNullAssertedOptionalChain": "error",
        "noRedundantUseStrict": "error",
        "noSelfCompare": "error",
        "noTsIgnore": "error",
        "noUnsafeNegation": "error",
        "noUnusedExpressions": "error",
        "noUselessEscapeInString": "error",
        "noUselessRegexBackrefs": "error",
        "useAwait": "error",
        "useDeprecatedDate": "error"
      },
      "security": {
        "preset": "recommended",
        "noDangerouslySetInnerHtml": "error",
        "noDangerouslySetInnerHtmlWithChildren": "error",
        "noGlobalEval": "error",
        "noScriptUrl": "error"
      },
      "style": {
        "preset": "recommended",
        "noInferrableTypes": "error",
        "noNestedTernary": "error",
        "noNonNullAssertion": "error",
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "dayjs": "Do not import dayjs directly. Use centralized date helpers from @/utils/Date instead.",
              "moment": "Do not use moment. Use centralized date helpers from @/utils/Date instead.",
              "date-fns": "Do not use date-fns. Use centralized date helpers from @/utils/Date instead.",
              "luxon": "Do not use luxon. Use centralized date helpers from @/utils/Date instead."
            },
            "patterns": [
              {
                "group": ["dayjs/**", "date-fns/**"],
                "message": "Do not import date sub-modules directly. Use @/utils/Date instead."
              }
            ]
          }
        },
        "noUselessElse": "error",
        "useAsConstAssertion": "error",
        "useConst": "error",
        "useExportType": "error",
        "useFragmentSyntax": "error",
        "useImportType": "error",
        "useSelfClosingElements": "error"
      },
      "performance": {
        "preset": "recommended",
        "noAccumulatingSpread": "error",
        "noDelete": "error",
        "useTopLevelRegex": "error"
      },
      "complexity": {
        "preset": "recommended",
        "noAdjacentSpacesInRegex": "error",
        "noEmptyTypeParameters": "error",
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": {
            "maxAllowedComplexity": 10
          }
        },
        "noExtraBooleanCast": "error",
        "noUselessCatch": "error",
        "noUselessCatchBinding": "error",
        "noUselessEmptyExport": "error",
        "noUselessEscapeInRegex": "error",
        "noUselessFragments": "error",
        "noUselessRename": "error",
        "noUselessReturn": "error",
        "noUselessStringConcat": "error",
        "noUselessSwitchCase": "error",
        "noUselessTernary": "error",
        "noUselessThisAlias": "error",
        "noUselessTypeConstraint": "error",
        "noUselessUndefinedInitialization": "error",
        "useDateNow": "error",
        "useFlatMap": "error",
        "useOptionalChain": "error",
        "useRegexLiterals": "error",
        "useSimplifiedLogicExpression": "error"
      },
      "nursery": {
        "noDrizzleDeleteWithoutWhere": "error",
        "noDrizzleUpdateWithoutWhere": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["utils/Date.ts", "index.ts", "jest.setup.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    },
    {
      "includes": ["app/**", "components/**"],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": {
              "level": "error",
              "options": {
                "maxAllowedComplexity": 15
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "**/__tests__/**",
        "**/*.test.ts",
        "**/*.test.tsx",
        "jest.setup.ts",
        "jest.config.js",
        "scripts/**",
        "plugins/**"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off",
            "useAwait": "off"
          },
          "complexity": {
            "noExcessiveCognitiveComplexity": "off"
          },
          "performance": {
            "useTopLevelRegex": "off"
          }
        }
      }
    }
  ]
}
