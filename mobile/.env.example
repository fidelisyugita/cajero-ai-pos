EXPO_PUBLIC_API_URL=api_url

EXPO_PUBLIC_DEV_STAFF_EMAIL=staff_email
EXPO_PUBLIC_DEV_STAFF_PASSWORD=staff_password
EXPO_PUBLIC_DEV_OWNER_EMAIL=owner_email
EXPO_PUBLIC_DEV_OWNER_PASSWORD=owner_password

# PostHog Analytics (Production Only)
EXPO_PUBLIC_POSTHOG_API_KEY=phc_your_production_api_key
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Sentry Error Tracking (Production Only)
EXPO_PUBLIC_SENTRY_DSN=https://your_sentry_dsn@sentry.io/project
# Sentry CLI Auth Token (Optional for local builds; required for uploading sourcemaps to Sentry)
SENTRY_AUTH_TOKEN=sntrys_your_auth_token_here

# Android Release Signing (build-time only, set as GitHub Actions Secrets)
ANDROID_UPLOAD_STORE_FILE=credentials/upload.keystore
ANDROID_UPLOAD_STORE_PASSWORD=your_store_password
ANDROID_UPLOAD_KEY_ALIAS=your_key_alias
ANDROID_UPLOAD_KEY_PASSWORD=your_key_password
