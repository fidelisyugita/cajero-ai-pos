{
  "expo": {
    "name": "Cajero",
    "slug": "cajero",
    "version": "1.1.0",
    "orientation": "landscape",
    "icon": "./assets/images/icon.png",
    "scheme": "cajero",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cajero.app",
      "icon": {
        "dark": "./assets/images/ios-light.png",
        "light": "./assets/images/ios-light.png"
      },
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "monochromeImage": "./assets/images/adaptive-icon.png",
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FEF5E2"
      },
      "package": "com.cajero.app",
      "versionCode": 8,
      "allowBackup": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon-light.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FEF5E2"
        }
      ],
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "The app needs access to your photos to let you upload product images."
        }
      ],
      [
        "@config-plugins/react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "modes": ["central"],
          "bluetoothAlwaysPermission": "Allow $(PRODUCT_NAME) to connect to bluetooth devices",
          "neverForLocation": true
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0",
            "minSdkVersion": 24,
            "usesCleartextTraffic": true,
            "enableMinifyInReleaseBuilds": true,
            "extraProguardRules": "-allowaccessmodification\n-keep class com.facebook.react.bridge.** { *; }\n-keep class com.facebook.react.uimanager.** { *; }\n-keep class com.facebook.jni.** { *; }\n-keep class com.mrousavy.nitro.** { *; }\n-keepclassmembers class * extends com.mrousavy.nitro.HybridObject { *; }\n-keep class expo.modules.sqlite.** { *; }\n-keep class io.requery.android.database.sqlite.** { *; }\n-keep class com.polidea.reactnativeble.** { *; }\n-keep class com.polidea.rxandroidble2.RxBle** { *; }\n-keep class com.polidea.rxandroidble2.scan.** { *; }\n-dontwarn com.polidea.rxandroidble2.**\n-keep class com.swmansion.rnscreens.** { *; }\n-keep class com.swmansion.gesturehandler.** { *; }\n-keep class com.reactnativekeyboardcontroller.** { *; }"
          }
        }
      ],
      "./plugins/withAndroidSigning",
      "./plugins/withAndroidSizeOptimizations",
      "./plugins/withIosXcode26Fix",
      "./plugins/withSentryConfig",
      "@react-native-community/datetimepicker",
      [
        "@sentry/react-native",
        {
          "organization": "cajero-bj",
          "project": "react-native",
          "disableAutoUpload": true
        }
      ],
      "expo-asset",
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
