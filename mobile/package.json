{
  "name": "cajero",
  "main": "index.ts",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "restart-adb": "adb kill-server && adb start-server",
    "android": "expo run:android",
    "android:prebuild": "expo prebuild --platform android",
    "android:release": "expo run:android --variant release",
    "android:clean": "cd android && ./gradlew clean && cd .. && expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:hygiene": "node ./scripts/check-comment-hygiene.js",
    "lint:hygiene:fix": "node ./scripts/check-comment-hygiene.js --fix",
    "lint:test": "biome check app/**/__tests__/** components/**/__tests__/** db/**/__tests__/** hooks/**/__tests__/** lib/**/__tests__/** services/**/__tests__/** store/**/__tests__/** utils/**/__tests__/** jest.setup.ts jest.config.js",
    "lint:test:fix": "biome check --write app/**/__tests__/** components/**/__tests__/** db/**/__tests__/** hooks/**/__tests__/** lib/**/__tests__/** services/**/__tests__/** store/**/__tests__/** utils/**/__tests__/** jest.setup.ts jest.config.js",
    "format": "biome format . --write",
    "format:check": "biome format .",
    "build:apk": "cd android && ./gradlew assembleRelease",
    "build:apk:clean": "cd android && ./gradlew clean assembleRelease",
    "bundle:android": "cd android && ./gradlew bundleRelease",
    "maestro:test": "maestro test --debug-output ./.maestro/output .maestro/tests/",
    "maestro:sign-in": "maestro test --debug-output ./.maestro/output .maestro/tests/sign-in.yaml",
    "maestro:validation": "maestro test --debug-output ./.maestro/output .maestro/tests/sign-in-validation.yaml",
    "maestro:studio": "maestro studio",
    "maestro:record": "maestro record .maestro/tests/sign-in.yaml",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "typecheck": "tsc --noEmit"
  },
