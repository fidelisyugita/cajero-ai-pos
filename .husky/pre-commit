# Block staged research docs or ephemeral files
if git diff --cached --name-only | grep -E '^(docs/research/|\.tmp/)' > /dev/null; then
  echo "❌ Error: Research artifacts under docs/research/ or .tmp/ must not be committed."
  exit 1
fi

# Run Biome lint+format on staged mobile files (via lint-staged)
echo "🔍 Checking staged mobile files with Biome..."
yarn lint-staged

# Run comment hygiene check — blocks commit on violation
echo "🧹 Running comment hygiene check..."
cd mobile && yarn lint:hygiene && yarn check:migrations
